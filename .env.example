# Copy to your deployment platform's environment settings — do NOT commit real values.

# Cloudflare SMTP relay
MAIL_HOST=smtp.mx.cloudflare.net
MAIL_PORT=465
MAIL_SCHEME=ssl
MAIL_USERNAME=api_token
MAIL_PASSWORD=replace-with-a-freshly-rotated-token
MAIL_FROM_ADDRESS=noreply@klveen.com
MAIL_FROM_NAME=KLVEEN
CONTACT_TO_EMAIL=support@klveen.com

# Rate limiting (optional overrides; defaults shown)
# CONTACT_RATE_LIMIT=5
# CONTACT_RATE_WINDOW_SECONDS=600

# Durable rate limiting across instances (recommended in production)
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-rest-token

# Cloudflare Turnstile (optional; when set, the route verifies the token)
# TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
