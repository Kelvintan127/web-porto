# Copy to Coolify's Environment Variables panel — do NOT commit real values.

# Resend SMTP (https://resend.com). MAIL_PASSWORD is the Resend API key.
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=resend
MAIL_PASSWORD=re_replace-with-your-resend-api-key
MAIL_FROM_ADDRESS=noreply@klveen.com
MAIL_FROM_NAME=KLVEEN Contact
CONTACT_TO_EMAIL=support@klveen.com

# Envelope sender. Optional; defaults to MAIL_FROM_ADDRESS. Kept explicit so the
# bounce path can never be rewritten to the visitor's address.
# MAIL_ENVELOPE_FROM=noreply@klveen.com

# Rate limiting (optional overrides; defaults shown)
# CONTACT_RATE_LIMIT=5
# CONTACT_RATE_WINDOW_SECONDS=600

# Durable rate limiting across instances (recommended in production)
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=replace-with-rest-token

# Cloudflare Turnstile (optional; when set, the route verifies the token)
# TURNSTILE_SECRET_KEY=replace-with-turnstile-secret
